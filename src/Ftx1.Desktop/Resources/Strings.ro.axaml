<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="Title">FTX-1 CAT și control la distanță · Etapa 4</sys:String>
  <sys:String x:Key="Connection">Conexiune</sys:String>
  <sys:String x:Key="CatPort">Port CAT</sys:String>
  <sys:String x:Key="Baud">Viteză CAT</sys:String>
  <sys:String x:Key="PttMethod">Metodă PTT</sys:String>
  <sys:String x:Key="PttPort">Port PTT separat</sys:String>
  <sys:String x:Key="Simulator">Simulator (fără stație)</sys:String>
  <sys:String x:Key="Connect">Conectare</sys:String>
  <sys:String x:Key="Disconnect">Deconectare</sys:String>
  <sys:String x:Key="RefreshPorts">Actualizează porturile</sys:String>
  <sys:String x:Key="Disconnected">Deconectat</sys:String>
  <sys:String x:Key="Connected">Conectat</sys:String>
  <sys:String x:Key="Firmware">Firmware</sys:String>
  <sys:String x:Key="TxLimit">Limită emisie (10–600 s)</sys:String>
  <sys:String x:Key="Frequency">Frecvența VFO-A</sys:String>
  <sys:String x:Key="FrequencyHint">Rotița pe o cifră schimbă acea cifră · 7.074 = MHz · 14200 = kHz</sys:String>
  <sys:String x:Key="Tune">Acordă</sys:String>
  <sys:String x:Key="VfoB">VFO-B</sys:String>
  <sys:String x:Key="Mode">Mod</sys:String>
  <sys:String x:Key="Band">Bandă</sys:String>
  <sys:String x:Key="Swap">A ⇄ B</sys:String>
  <sys:String x:Key="Copy">A → B</sys:String>
  <sys:String x:Key="Split">SPLIT</sys:String>
  <sys:String x:Key="Af">AF · volum</sys:String>
  <sys:String x:Key="Rf">RF · câștig</sys:String>
  <sys:String x:Key="Sql">SQL · squelch</sys:String>
  <sys:String x:Key="Power">Putere (W)</sys:String>
  <sys:String x:Key="Mic">MIC · nivel</sys:String>
  <sys:String x:Key="Nb">NB</sys:String>
  <sys:String x:Key="Dnr">DNR</sys:String>
  <sys:String x:Key="Dnf">DNF</sys:String>
  <sys:String x:Key="Att">ATT</sys:String>
  <sys:String x:Key="Preamp">IPO / AMP</sys:String>
  <sys:String x:Key="Agc">AGC</sys:String>
  <sys:String x:Key="Narrow">NAR</sys:String>
  <sys:String x:Key="Lock">LOCK</sys:String>
  <sys:String x:Key="Tuner">Tuner</sys:String>
  <sys:String x:Key="Ptt">PTT · ține apăsat / Space</sys:String>
  <sys:String x:Key="Stop">STOP · Esc</sys:String>
  <sys:String x:Key="MenuStation">_Stație</sys:String>
  <sys:String x:Key="MenuSettings">_Setări stație…</sys:String>
  <sys:String x:Key="MenuExit">_Ieșire</sys:String>
  <sys:String x:Key="MenuTools">_Unelte</sys:String>
  <sys:String x:Key="MenuConsole">_Consolă CAT…</sys:String>
  <sys:String x:Key="OpenSettings">Setări…</sys:String>
  <sys:String x:Key="SettingsTitle">Setări stație</sys:String>
  <sys:String x:Key="TabConnection">Conexiune</sys:String>
  <sys:String x:Key="TabConsole">Consolă CAT</sys:String>
  <sys:String x:Key="SettingsLockedHint">Setările de conexiune se pot schimba doar după deconectare.</sys:String>
  <sys:String x:Key="ConsoleHint">„&gt;” = comandă trimisă către stație · „&lt;” = răspunsul stației. Exemple: FA; (citește frecvența VFO-A) · MD0; (citește modul) · AG0128; (volum AF). Comenzile care pot porni emisia (TX, KY…) sunt blocate aici: folosește PTT.</sys:String>
  <sys:String x:Key="CommandWatermark">Comandă CAT, de ex. FA;</sys:String>
  <sys:String x:Key="SendRaw">Transmite</sys:String>
  <sys:String x:Key="SendRawTip">Trimite comanda CAT către stație (Enter). Nu pornește emisia radio.</sys:String>
  <sys:String x:Key="Clear">Șterge jurnalul</sys:String>
  <sys:String x:Key="ConfigError">Configurarea nu a putut fi citită.</sys:String>
  <sys:String x:Key="OperationError">Operația nu a reușit:</sys:String>
  <sys:String x:Key="InvalidFrequency">Frecvență invalidă.</sys:String>
  <sys:String x:Key="InvalidTxLimit">Limita de emisie trebuie să fie între 10 și 600 secunde.</sys:String>
  <sys:String x:Key="InvalidBaud">Viteza CAT nu este validă.</sys:String>
  <sys:String x:Key="InvalidPtt">Metodă PTT invalidă.</sys:String>
  <sys:String x:Key="InvalidCatPort">Selectează un port CAT valid.</sys:String>
  <sys:String x:Key="InvalidPttPort">Selectează un port PTT separat, diferit de portul CAT.</sys:String>
  <sys:String x:Key="MissingPttPort">Portul PTT nu este configurat.</sys:String>
  <sys:String x:Key="UnsafeRawTransmit">Comanda poate activa emisia. Folosește PTT sau acțiunea dedicată, protejată de watchdog.</sys:String>
  <sys:String x:Key="TransmitBusy">Emisia este ocupată sau stația este deconectată.</sys:String>
  <sys:String x:Key="StopTimeout">Emisia a fost oprită: limita de timp a fost depășită.</sys:String>
  <sys:String x:Key="StopLostHeartbeat">Emisia a fost oprită: lipsă semnal de viață.</sys:String>
  <sys:String x:Key="StopDisconnected">Emisia a fost oprită: conexiunea s-a pierdut.</sys:String>
  <sys:String x:Key="StopFailure">Emisia a fost oprită din cauza unei erori.</sys:String>
  <sys:String x:Key="StopShutdown">Emisia a fost oprită la închiderea aplicației.</sys:String>
  <sys:String x:Key="SMeter">S: {0:F1}</sys:String>
  <sys:String x:Key="TxMeters">PO: {0:F1} W · SWR: {1:F1} · ALC: {2:F0}</sys:String>
  <sys:String x:Key="ServerAddress">Adresa serverului (wss://…/ws)</sys:String>
  <sys:String x:Key="Fingerprint">Amprenta SHA-256 a certificatului</sys:String>
  <sys:String x:Key="DeviceToken">Tokenul acestui dispozitiv</sys:String>
  <sys:String x:Key="PairingData">Datele de asociere (JSON din QR)</sys:String>
  <sys:String x:Key="PairDevice">Asociază dispozitivul</sys:String>
  <sys:String x:Key="LatencyFormat">Latență: {0} ms</sys:String>
  <sys:String x:Key="PairingSucceeded">Dispozitiv asociat. Apasă Conectare.</sys:String>
  <sys:String x:Key="InvalidPairing">Date de asociere invalide.</sys:String>
  <sys:String x:Key="InvalidServerAddress">Adresa trebuie să fie wss://server:port/ws.</sys:String>
  <sys:String x:Key="InvalidFingerprint">Amprenta trebuie să conțină 64 de cifre hexazecimale.</sys:String>
  <sys:String x:Key="AuthenticationFailed">Autentificare refuzată. Verifică asocierea sau tokenul.</sys:String>
  <sys:String x:Key="ProtocolMismatch">Versiune de protocol incompatibilă. Actualizează clientul.</sys:String>
  <sys:String x:Key="TotWarning">TOT al stației este oprit sau nu a putut fi citit.</sys:String>
  <sys:String x:Key="SetTot">Setează TOT la 3 minute</sys:String>
  <sys:String x:Key="ServerTitle">FTX-1 · Serverul stației</sys:String>
  <sys:String x:Key="ShowServer">Deschide administrarea</sys:String>
  <sys:String x:Key="ExitApplication">Ieșire din aplicație</sys:String>
  <sys:String x:Key="StartServer">Pornește serverul</sys:String>
  <sys:String x:Key="StopServer">Oprește serverul</sys:String>
  <sys:String x:Key="ServerRunning">Server pornit</sys:String>
  <sys:String x:Key="ServerStopped">Server oprit</sys:String>
  <sys:String x:Key="StartWithWindows">Pornește serverul cu Windows, în tray</sys:String>
  <sys:String x:Key="PairingHelp">Instalează Tailscale pe PC și client. Asociază dispozitivul folosind QR-ul sau datele de mai jos; codul este valabil 5 minute și se folosește o singură dată.</sys:String>
  <sys:String x:Key="NewPairing">Generează cod de asociere</sys:String>
  <sys:String x:Key="Devices">Dispozitive asociate</sys:String>
  <sys:String x:Key="RevokeDevice">Revocă dispozitivul selectat</sys:String>
  <sys:String x:Key="NoTailscale">Tailscale nu este detectat; acces doar de pe acest PC</sys:String>
  <sys:String x:Key="ServerCloseHint">X ascunde administrarea în tray. Pentru oprire completă folosește Ieșire din aplicație din meniul tray.</sys:String>
  <sys:String x:Key="StopHighSwr">Emisia a fost oprită: SWR prea mare.</sys:String>
  <sys:String x:Key="AuditWriteFailed">Jurnalul emisiei nu a putut fi scris.</sys:String>
  <sys:String x:Key="OperationFailed">Operația nu a reușit.</sys:String>
  <sys:String x:Key="MenuFailed">Operația EX nu a reușit.</sys:String>
  <sys:String x:Key="UnsupportedMessage">Mesaj de protocol necunoscut.</sys:String>
  <sys:String x:Key="InvalidMessage">Mesaj de protocol invalid.</sys:String>
  <sys:String x:Key="StopRevoked">Emisia a fost oprită: dispozitivul a fost revocat.</sys:String>
  <sys:String x:Key="AudioTitle">Audio prin internet</sys:String>
  <sys:String x:Key="AudioHelp">Opus mono 16 kHz, cadre de 20 ms. Folosește căști pentru a evita ecoul. Modifică dispozitivele sau debitul după deconectare. Microfonul este transmis numai cât ții apăsat PTT.</sys:String>
  <sys:String x:Key="AudioEnabled">Activează audio (necesar pentru PTT vocal)</sys:String>
  <sys:String x:Key="AudioInput">Intrare audio / microfon</sys:String>
  <sys:String x:Key="AudioOutput">Ieșire audio / difuzor</sys:String>
  <sys:String x:Key="AudioDefault">Dispozitiv implicit de comunicații Windows</sys:String>
  <sys:String x:Key="AudioAutoUsb">Detectează automat USB Audio CODEC</sys:String>
  <sys:String x:Key="AudioBitrate">Debit Opus (biți/s): 12000 / 24000 / 32000</sys:String>
  <sys:String x:Key="AudioQualityFormat">Opus · tampon {0}/{1} ms · cadre lipsă {2} · întârziate {3}</sys:String>
  <sys:String x:Key="AudioInactive">Audio inactiv</sys:String>
  <sys:String x:Key="AudioUnavailable">Audio indisponibil. Verifică dispozitivele, permisiunea microfonului și setările audio.</sys:String>
  <sys:String x:Key="AudioRequired">Activează audio și așteaptă conectarea înainte de PTT.</sys:String>
  <sys:String x:Key="UsbCodecNotFound">Nu s-a găsit perechea USB Audio CODEC. Alege intrarea și ieșirea stației în server.</sys:String>
  <sys:String x:Key="AudioWindowsOnly">Audio WASAPI este disponibil pe Windows.</sys:String>
  <sys:String x:Key="AudioStationHelp">Audio stație: USB Audio CODEC pentru intrare și ieșire. Simulatorul generează tonuri și ecou întârziat.</sys:String>
  <sys:String x:Key="StopLostAudio">Emisia a fost oprită: fluxul microfonului lipsește de peste o secundă.</sys:String>
  <sys:String x:Key="MobileAppName">FTX1 Remote</sys:String>
  <sys:String x:Key="MobileRadioTab">Stație</sys:String>
  <sys:String x:Key="MobileSettingsTab">Setări</sys:String>
  <sys:String x:Key="MobileTuneHint">Glisează frecvența sau folosește − / + cu pasul selectat (Hz).</sys:String>
  <sys:String x:Key="MobilePtt">PTT · ține apăsat</sys:String>
  <sys:String x:Key="DeviceName">Numele dispozitivului</sys:String>
  <sys:String x:Key="MobilePairHelp">Asociază telefonul cu QR-ul din serverul Windows. Tailscale trebuie să fie conectat pe ambele dispozitive. Poți lipi și datele JSON de sub QR.</sys:String>
  <sys:String x:Key="MobileScanQr">Scanează QR</sys:String>
  <sys:String x:Key="MobileQrHint">Încadrează întregul cod QR și ține telefonul nemișcat. După recunoaștere, apasă Folosește codul.</sys:String>
  <sys:String x:Key="MobilePermissionsDenied">Permisiunile microfonului și notificărilor sunt necesare pentru audio. Activează-le în setările Android ale aplicației.</sys:String>
  <sys:String x:Key="MobileCameraDenied">Camera nu este disponibilă sau permisiunea a fost refuzată. Poți lipi datele de asociere în Setări.</sys:String>
  <sys:String x:Key="MobileFocusUnavailable">Audio este folosit de altă aplicație sau există un apel. Revino și conectează din nou.</sys:String>
  <sys:String x:Key="MobilePttUnavailable">PTT necesită ecranul aplicației activ, serviciul pornit, audio disponibil și rețea.</sys:String>
  <sys:String x:Key="MobileNotificationChannel">Conexiune și audio FTX1</sys:String>
  <sys:String x:Key="MobileNotificationTitle">Conectat la FTX1</sys:String>
  <sys:String x:Key="MobileNotificationFormat">{0:F3} MHz · {1} · audio activ</sys:String>
  <sys:String x:Key="MobileBackgroundHelp">Recepția continuă cu ecranul stins cât notificarea conexiunii este prezentă. Ieșirea din ecran eliberează PTT. Apelurile și deconectarea căștilor întrerup emisia; după ele poți relua audio.</sys:String>
  <sys:String x:Key="MobileResumeAudio">Reia audio</sys:String>
  <sys:String x:Key="MobileDevicesHelp">Acest telefon este un dispozitiv asociat. Lista completă și revocarea dispozitivelor sunt în administrarea serverului Windows.</sys:String>
  <sys:String x:Key="MobileKeyProtected">Datele de autentificare sunt criptate cu o cheie protejată de Android Keystore.</sys:String>
  <sys:String x:Key="MobileConsoleTab">CAT</sys:String>
  <sys:String x:Key="MobileDevicesTab">Dispozitiv</sys:String>
  <sys:String x:Key="MobileTuneMinus">−</sys:String>
  <sys:String x:Key="MobileTunePlus">+</sys:String>
  <sys:String x:Key="MobileNotificationReconnecting">Reconectare la FTX1</sys:String>
  <sys:String x:Key="MobileNotificationPausedFormat">{0:F3} MHz · {1} · audio întrerupt</sys:String>
  <sys:String x:Key="AudioNotStarted">Audio se inițializează când se conectează clientul sau la Verifică audio.</sys:String>
  <sys:String x:Key="AudioRunning">Audio activ:</sys:String>
  <sys:String x:Key="ServerAudioUnavailable">Audio indisponibil pe SERVER:</sys:String>
  <sys:String x:Key="ClientAudioUnavailable">Audio indisponibil pe CLIENT:</sys:String>
  <sys:String x:Key="ServerCleanupWarning">O resursă a raportat o eroare la închidere; detalii în server-errors.log.</sys:String>
  <sys:String x:Key="AudioStartServerFirst">Pornește serverul înainte de verificarea audio.</sys:String>
  <sys:String x:Key="TestAudio">Verifică audio</sys:String>
  <sys:String x:Key="AudioSelectionHelp">Pentru modificarea porturilor sau a plăcii audio, apasă Oprește serverul. Pe server alege intrarea și ieșirea USB ale stației; în client alege microfonul și căștile PC-ului. Eroarea exactă este afișată mai sus.</sys:String>
  <sys:String x:Key="QrImageFailed">Imaginea QR nu a putut fi afișată; datele JSON de asociere sunt disponibile.</sys:String>
  <sys:String x:Key="AllowLan">Permite acces din rețeaua locală (LAN)</sys:String>
  <sys:String x:Key="LanAddressHint">Adresa IPv4 a acestui PC, de exemplu 192.168.55.167</sys:String>
  <sys:String x:Key="LanHelp">LAN este dezactivat implicit. Pentru un alt PC din aceeași rețea, bifează opțiunea și introdu adresa acestui PC. Permite aplicația în Windows Firewall doar pentru rețeaua privată. Generează apoi un QR nou; nu modifica manual adresa sau certificatul din JSON.</sys:String>
  <sys:String x:Key="InvalidLanAddress">Introdu o adresă LAN privată validă a acestui PC: 192.168.x.x, 10.x.x.x sau 172.16–31.x.x.</sys:String>
  <sys:String x:Key="PairingServerUnreachable">Serverul de asociere nu răspunde. Verifică dacă este pornit și dacă adresa/portul din QR sunt accesibile. Pentru 192.168.x.x activează LAN în server și verifică firewall-ul; pentru internet folosește adresa Tailscale.</sys:String>
  <sys:String x:Key="PairingCertificateMismatch">Certificatul nu corespunde datelor QR. Generează un QR nou în serverul corect și copiază întregul JSON.</sys:String>
  <sys:String x:Key="PairingCodeExpired">Codul de asociere a expirat sau a fost folosit. Generează un QR nou în server.</sys:String>
  <sys:String x:Key="PairingRateLimited">Prea multe încercări de asociere. Așteaptă câteva minute înainte de o nouă încercare.</sys:String>
  <sys:String x:Key="MobileQrUse">Folosește codul</sys:String>
  <sys:String x:Key="MobileQrRecognized">Cod recunoscut pentru {0}. Apasă Folosește codul.</sys:String>
  <sys:String x:Key="MobileCameraUnavailable">Camera nu poate fi pornită. Închide alte aplicații care o folosesc și reîncearcă.</sys:String>
  <sys:String x:Key="MobileSpeakerSelected">Difuzor telefon selectat · apasă pentru automat</sys:String>
  <sys:String x:Key="MobileSpeakerChoose">Folosește difuzorul telefonului</sys:String>
  <sys:String x:Key="MobilePhoneVolume">Volum telefon (independent de AF-ul stației)</sys:String>
  <sys:String x:Key="MobileRouteSpeaker">Ieșire: difuzor telefon</sys:String>
  <sys:String x:Key="MobileRouteEarpiece">Ieșire: casca pentru convorbiri</sys:String>
  <sys:String x:Key="MobileRouteHeadset">Ieșire: căști</sys:String>
  <sys:String x:Key="MobileRouteBluetooth">Ieșire: Bluetooth</sys:String>
  <sys:String x:Key="MobileRouteAutomatic">Ieșire: automată</sys:String>
  <sys:String x:Key="MobileRouteDisconnected">Ieșirea audio va fi activată la conectare.</sys:String>
  <sys:String x:Key="MobileRouteFailed">Nu s-a putut selecta ieșirea audio. Verifică dispozitivele și permisiunile.</sys:String>
</ResourceDictionary>
