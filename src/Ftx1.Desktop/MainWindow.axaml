<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Ftx1.Desktop.MainWindow"
        Title="{DynamicResource Title}" Width="1200" Height="850" MinWidth="820" MinHeight="600">
  <Window.Styles>
    <Style Selector="Border.card"><Setter Property="Background" Value="#17212D"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style Selector="Button.digit"><Setter Property="FontSize" Value="42"/><Setter Property="FontFamily" Value="monospace"/><Setter Property="Padding" Value="3,0"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="TextBox"><Setter Property="MinWidth" Value="95"/></Style>
  </Window.Styles>
  <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#101820">
    <MenuItem Header="{DynamicResource MenuStation}">
      <MenuItem Header="{Binding ConnectionLabel}" Command="{Binding ConnectCommand}"/>
      <MenuItem Header="{DynamicResource MenuSettings}" InputGesture="F2" Click="OpenSettings"/>
      <Separator/>
      <MenuItem Header="{DynamicResource MenuExit}" Click="ExitClicked"/>
    </MenuItem>
    <MenuItem Header="{DynamicResource MenuTools}">
      <MenuItem Header="{DynamicResource MenuConsole}" InputGesture="F12" Click="OpenConsole"/>
    </MenuItem>
  </Menu>
  <ScrollViewer><StackPanel Margin="20" Spacing="4">
    <TextBlock Text="{DynamicResource Title}" FontSize="25" FontWeight="Bold" Margin="0,0,0,16"/>
    <Border Classes="card"><StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="{Binding ConnectionLabel}" Command="{Binding ConnectCommand}"/><Button Content="{DynamicResource OpenSettings}" Click="OpenSettings"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center"/></StackPanel>
      <TextBlock Text="{Binding Latency}"/><StackPanel IsVisible="{Binding TotWarning}" Orientation="Horizontal" Spacing="10"><TextBlock Text="{DynamicResource TotWarning}"/><Button Content="{DynamicResource SetTot}" Command="{Binding SetTotCommand}"/></StackPanel>
      <TextBlock Text="{Binding Notice}" Foreground="#FFBD75" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="12" IsEnabled="{Binding ConnectionOpen}">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Frequency}" Classes="heading"/><TextBlock Grid.Column="1" Text="{Binding Meter}" FontSize="20" Foreground="#64D5C3"/></Grid>
      <ItemsControl ItemsSource="{Binding Digits}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Classes="digit" Content="{Binding Text}" Tag="{Binding Power}" PointerWheelChanged="DigitWheel"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{DynamicResource FrequencyHint}" Opacity="0.65"/>
      <WrapPanel>
        <TextBox Width="180" Text="{Binding FrequencyInput}" KeyDown="FrequencyKey" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource Tune}" Command="{Binding TuneInputCommand}" Margin="0,0,16,8"/>
        <TextBlock Text="{DynamicResource VfoB}" Margin="0,8,8,0"/><TextBlock Text="{Binding FrequencyB}" FontSize="20" Margin="0,4,16,0"/>
        <Button Content="{DynamicResource Swap}" Command="{Binding ActionCommand}" CommandParameter="swap" Margin="0,0,8,8"/>
        <Button Content="{DynamicResource Copy}" Command="{Binding ActionCommand}" CommandParameter="a_to_b" Margin="0,0,8,8"/>
        <CheckBox Content="{DynamicResource Split}" IsChecked="{Binding Split}"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{DynamicResource Band}" VerticalAlignment="Center"/><ComboBox Width="140" ItemsSource="{Binding Bands}" SelectedIndex="{Binding SelectedBand}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{DynamicResource Mode}" VerticalAlignment="Center"/><ComboBox Width="140" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/></StackPanel>
      <Grid ColumnDefinitions="*,*,*,*,*">
        <StackPanel><TextBlock Text="{DynamicResource Af}"/><Slider Minimum="0" Maximum="255" Value="{Binding Af}"/><TextBlock Text="{Binding Af,StringFormat={}{0:F0}}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Rf}"/><Slider Minimum="0" Maximum="255" Value="{Binding Rf}"/><TextBlock Text="{Binding Rf,StringFormat={}{0:F0}}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Sql}"/><Slider Minimum="0" Maximum="255" Value="{Binding Sql}"/><TextBlock Text="{Binding Sql,StringFormat={}{0:F0}}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource Power}"/><Slider Minimum="{Binding MinPower}" Maximum="{Binding MaxPower}" Value="{Binding Power}"/><TextBlock Text="{Binding Power,StringFormat={}{0:F1}}"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="{DynamicResource Mic}"/><Slider Minimum="0" Maximum="100" Value="{Binding Mic}"/><TextBlock Text="{Binding Mic,StringFormat={}{0:F0}}"/></StackPanel>
      </Grid>
      <WrapPanel>
        <Button Content="{DynamicResource Nb}" Command="{Binding ToggleCommand}" CommandParameter="nb" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Dnr}" Command="{Binding ToggleCommand}" CommandParameter="nr" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Dnf}" Command="{Binding ToggleCommand}" CommandParameter="dnf" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Att}" Command="{Binding ToggleCommand}" CommandParameter="att" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Preamp}" Command="{Binding ToggleCommand}" CommandParameter="preamp" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Agc}" Command="{Binding ToggleCommand}" CommandParameter="agc" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Narrow}" Command="{Binding ToggleCommand}" CommandParameter="narrow" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Lock}" Command="{Binding ToggleCommand}" CommandParameter="lock" Margin="0,0,6,6"/>
        <Button Content="{DynamicResource Tuner}" Command="{Binding ActionCommand}" CommandParameter="tune"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="{DynamicResource Ptt}" Background="#266256" MinWidth="250" PointerPressed="PttPressed" PointerReleased="PttReleased" PointerCaptureLost="PttCaptureLost"/><Button Content="{DynamicResource Stop}" Command="{Binding StopCommand}" Background="#803B41"/><TextBlock Text="{Binding TxTime}" FontSize="22" VerticalAlignment="Center"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Text="{Binding AudioQuality}" Opacity="0.8" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
