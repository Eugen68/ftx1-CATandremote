<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Ftx1.App.SettingsWindow"
        Title="{DynamicResource SettingsTitle}" Width="760" Height="560" MinWidth="560" MinHeight="420">
  <TabControl x:Name="Tabs" Margin="12">
    <TabItem Header="{DynamicResource TabConnection}">
      <StackPanel Spacing="12" Margin="4,12">
        <TextBlock Text="{DynamicResource SettingsLockedHint}" Opacity="0.65" TextWrapping="Wrap" IsVisible="{Binding ConnectionOpen}"/>
        <WrapPanel IsEnabled="{Binding CanConfigure}" Orientation="Horizontal">
          <StackPanel Margin="0,0,14,10"><TextBlock Text="{DynamicResource CatPort}"/><ComboBox Width="150" ItemsSource="{Binding Ports}" SelectedItem="{Binding CatPort}"/></StackPanel>
          <StackPanel Margin="0,0,14,10"><TextBlock Text="{DynamicResource Baud}"/><ComboBox Width="110" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding Baud}"/></StackPanel>
          <StackPanel Margin="0,0,14,10"><TextBlock Text="{DynamicResource PttMethod}"/><ComboBox Width="105" ItemsSource="{Binding PttMethods}" SelectedItem="{Binding PttMethod}"/></StackPanel>
          <StackPanel Margin="0,0,14,10"><TextBlock Text="{DynamicResource PttPort}"/><ComboBox Width="150" ItemsSource="{Binding Ports}" SelectedItem="{Binding PttPort}"/></StackPanel>
          <StackPanel Margin="0,0,14,10"><TextBlock Text="{DynamicResource TxLimit}"/><NumericUpDown Width="150" Minimum="10" Maximum="600" Value="{Binding MaxTxSeconds}" FormatString="0"/></StackPanel>
          <CheckBox Content="{DynamicResource Simulator}" IsChecked="{Binding Simulator}" Margin="0,14,0,0"/>
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="{Binding ConnectionLabel}" Command="{Binding ConnectCommand}"/>
          <Button Content="{DynamicResource RefreshPorts}" Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding CanConfigure}"/>
          <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding Notice}" Foreground="#FFBD75" TextWrapping="Wrap"/>
      </StackPanel>
    </TabItem>
    <TabItem Header="{DynamicResource TabConsole}">
      <DockPanel Margin="4,12">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ConsoleHint}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
          <TextBox x:Name="CommandBox" Text="{Binding RawCommand}" Watermark="{DynamicResource CommandWatermark}" FontFamily="monospace" KeyDown="CommandKey"/>
          <Button Grid.Column="1" Content="{DynamicResource SendRaw}" ToolTip.Tip="{DynamicResource SendRawTip}" Command="{Binding SendRawCommand}" Margin="8,0,0,0"/>
          <Button Grid.Column="2" Content="{DynamicResource Clear}" Command="{Binding ClearLogCommand}" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notice}" Foreground="#FFBD75" TextWrapping="Wrap"/>
        <ListBox x:Name="Log" ItemsSource="{Binding CatLog}" FontFamily="monospace" FontSize="12"/>
      </DockPanel>
    </TabItem>
  </TabControl>
</Window>
